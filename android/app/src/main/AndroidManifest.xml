<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- No FOREGROUND_SERVICE here on purpose. Sleep tracking samples the
         screen state from short alarm-driven broadcasts instead of holding a
         service open all night, which removes both the permanent notification
         Android forces on foreground services and the FGS "specialUse"
         justification Play requires at review. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- The only permission the user is ever asked for. Enabling notifications
         is meant to be the whole setup: no exact-alarm access, no battery
         allowlist, no usage access, no special-access trip to Settings. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Deliberately absent, and each removal was a decision — re-adding any of
         them is a product choice, not a bug fix:

         - SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM. Exact alarms would make
           reminders punctual and sleep sampling reliable; without them Doze
           batches both into maintenance windows. The cost was judged higher
           than the benefit: USE_EXACT_ALARM is Play-restricted to alarm/clock
           apps, and SCHEDULE_EXACT_ALARM requires a Play Console permissions
           declaration whose accepted use cases (alarm/clock, calendar,
           timer apps) this app doesn't cleanly fit — real risk of a policy
           rejection, not just a Settings trip.
         - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. Same reasoning: a second
           Settings trip, and Play scrutinises it.
         - PACKAGE_USAGE_STATS. Sensitive-data special access needing a Data
           Safety declaration, for a feature that works without it.

         Everything therefore degrades rather than breaking, and the design
         compensates where it can — see SleepTrackingAlarmManager, which
         pre-schedules independent sample alarms precisely because a dropped
         one must not be able to end the night. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION"/>
    <!-- Voice meal logging -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Android 11+ package visibility for the on-device speech recogniser -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>

    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:name="${applicationName}"
        android:largeHeap="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="io.flutter.embedding.android.NormalTheme" android:resource="@style/NormalTheme"/>
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <!-- Supabase OAuth deep link callback -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.supabase.proteinix" android:host="login-callback"/>
            </intent-filter>
            <!-- RevenueCat paywall previews. The scheme is generated by the
                 RevenueCat dashboard (Apps → Proteinix (Play Store) → Custom
                 URL Scheme) and must match it character for character.
                 Development convenience only — nothing about purchases or
                 entitlements routes through here, so a mismatch breaks
                 previewing a paywall on device and nothing else.

                 No autoVerify: that is for https App Links, which Android
                 verifies against a domain. A custom scheme has no domain to
                 check, and asking for verification on one just logs a
                 failure at install time. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="rc-09790eb1b8"/>
            </intent-filter>
            <!-- Health Connect privacy-policy rationale, Android 13 and below.
                 Health Connect refuses to grant health.READ_* without a target
                 for this, and Play's health-data review checks for it. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>

        <!-- Same rationale hook for Android 14+, which routes it through
             VIEW_PERMISSION_USAGE instead. The START_VIEW_PERMISSION_USAGE
             permission is what stops any app but the system launching it. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <receiver android:name=".SleepTrackingReceiver" android:exported="false"/>
        <!-- Reads the hardware step counter every half hour so a reading lands
             near midnight. Without one, a day can only be counted from the
             first time the app is opened, and everything walked before that is
             unattributable and therefore lost. See StepCounter. -->
        <receiver android:name=".StepSamplingReceiver" android:exported="false"/>
        <!-- flutter_local_notifications ships NO receivers in its own manifest —
             only permissions. Without these three declared here the plugin's
             AlarmManager broadcast has nowhere to land, so every scheduled
             reminder registers successfully and then silently never fires,
             while an immediate show() keeps working. That asymmetry is exactly
             what "the test notification arrives but water/meal reminders don't"
             looks like. Do not remove. -->
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Required for the meal reminder's "Log meal" / "Skip" action buttons. -->
        <receiver android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>

        <!-- Flags reminder alarms for rebuild after a reboot or app update.
             flutter_local_notifications registers its own boot receiver too;
             this one is the fallback for OEMs where that restore doesn't run. -->
        <receiver android:name=".NotificationBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Restores the sleep tracking alarms after a reboot *or an app
             update*. Android cancels an app's alarms when it is replaced, so
             without MY_PACKAGE_REPLACED every install silently disarmed
             tracking while the dashboard still reported it as on. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- Separate filter: MY_PACKAGE_REPLACED carries a package data
                 scheme and will not match a filter that also declares the boot
                 actions. -->
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <meta-data android:name="flutterEmbedding" android:value="2"/>
        <!-- Impeller-over-Vulkan has documented artifacts on some MediaTek/Mali
             GPUs — small triangular spikes bleeding past the edge of any circle
             drawn with both a border and a shadow, which describes most of this
             app's buttons (IconBubble, ShutterButton, the streak badge's glow
             rings). Falling back to Skia trades Impeller's smoother animation
             perf for correct anti-aliasing on hardware like this. -->
        <meta-data android:name="io.flutter.embedding.android.EnableImpeller" android:value="false"/>
    </application>
</manifest>
